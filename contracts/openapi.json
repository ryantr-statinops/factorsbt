{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "FactorsBT MVP 1 local HTTP API",
    "version": "1.0.0",
    "description": "Proposed local HTTP/JSON contract. Phase A implements only GET /healthz; run operations remain specifications."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check the local backend process",
        "description": "Confirms that the API process accepts requests. It does not assert worker readiness or run-store durability.",
        "responses": {
          "200": {
            "description": "Backend process is responding.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "submitRun",
        "summary": "Validate and enqueue a run",
        "description": "Asynchronous submission. The caller must supply an Idempotency-Key and must not automatically retry after a lost acknowledgment.",
        "parameters": [ { "$ref": "#/components/parameters/IdempotencyKey" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "schemas/run-configuration.schema.json" } } }
        },
        "responses": {
          "202": {
            "description": "One run was accepted, or the original acknowledgment was replayed for an equivalent submission.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionAccepted" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/SubmissionConflict" },
          "422": { "$ref": "#/components/responses/InvalidRequest" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/submissions/{submission_id}": {
      "get": {
        "operationId": "getSubmission",
        "summary": "Resolve a submission ID to its current run",
        "parameters": [ { "$ref": "#/components/parameters/SubmissionId" } ],
        "responses": {
          "200": {
            "description": "Submission identity and current run status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionStatus" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Inspect run lifecycle and progress",
        "parameters": [ { "$ref": "#/components/parameters/RunId" } ],
        "responses": {
          "200": {
            "description": "Run lifecycle, current progress, and terminal failure when applicable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs/{run_id}/results": {
      "get": {
        "operationId": "getRunResults",
        "summary": "Retrieve a successful run result and evidence references",
        "parameters": [ { "$ref": "#/components/parameters/RunId" } ],
        "responses": {
          "200": {
            "description": "Successful run summary, final portfolio, provenance, and local evidence references.",
            "content": { "application/json": { "schema": { "$ref": "schemas/run-result.schema.json" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RequestId": {
        "description": "Correlation ID for this HTTP exchange; it matches error.request_id in the JSON body.",
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Caller-supplied submission UUID. Reusing it with a different configuration returns a conflict.",
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "SubmissionId": {
        "name": "submission_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "contract_version"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "factorsbt-backend" },
          "contract_version": { "const": "1.0.0" }
        }
      },
      "SubmissionAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submission_id", "run_id", "status", "submitted_at"],
        "properties": {
          "submission_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "const": "queued" },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" }
        }
      },
      "SubmissionStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submission_id", "run_id", "status", "submitted_at"],
        "properties": {
          "submission_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "enum": ["queued", "running", "succeeded", "failed"] },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" }
        }
      },
      "RunStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "submitted_at", "started_at", "finished_at", "progress", "failure"],
        "properties": {
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "enum": ["queued", "running", "succeeded", "failed"] },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" },
          "started_at": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "finished_at": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "progress": { "oneOf": [ { "$ref": "#/components/schemas/Progress" }, { "type": "null" } ] },
          "failure": { "oneOf": [ { "$ref": "#/components/schemas/RunFailure" }, { "type": "null" } ] }
        }
      },
      "Progress": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "step_id", "simulation_time", "completed_steps", "total_steps"],
        "properties": {
          "scenario_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "step_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "simulation_time": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" },
          "completed_steps": { "type": "integer", "minimum": 0 },
          "total_steps": { "type": "integer", "minimum": 0 }
        }
      },
      "RunFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "message": { "type": "string", "minLength": 1 },
          "scenario_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "step_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "last_valid_state_ref": { "type": "string", "pattern": "^evidence/[^/]+(?:/[^/]+)*$" }
        }
      },
      "RunConfiguration": { "$ref": "schemas/run-configuration.schema.json" },
      "RunResult": { "$ref": "schemas/run-result.schema.json" },
      "ErrorResponse": { "$ref": "schemas/common.schema.json#/$defs/ApiErrorResponse" }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON, malformed resource ID, or missing/invalid idempotency key.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "SubmissionConflict": {
        "description": "The submission ID is already bound to a different configuration.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InvalidRequest": {
        "description": "The run configuration is schema-invalid, semantically invalid, or uses an unsupported contract version.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "The submission or run is not retained by this backend process.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "ResultsUnavailable": {
        "description": "The run has not succeeded or has failed; inspect the run-status resource.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalError": {
        "description": "Unexpected request-processing failure; no success is implied.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "BackendUnavailable": {
        "description": "The local backend cannot accept or inspect work.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
