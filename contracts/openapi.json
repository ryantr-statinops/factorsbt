{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "FactorsBT MVP 1 local HTTP API",
    "version": "1.0.0",
    "description": "Accepted MVP 1 HTTP/JSON contract. The loopback Rust service implements GET /healthz and the four /v1 run operations, with verification recorded in plan/implementation/06-backend-api.md. This local implementation has no public stability guarantee; the Python backtest SDK remains in Stage 07."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check the local backend process",
        "description": "Confirms that the local HTTP service responds after fixture registry, evidence directory, and workers have initialized. It does not mean any submitted run has completed.",
        "responses": {
          "200": {
            "description": "Backend process is responding.",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "submitRun",
        "summary": "Validate and enqueue a run",
        "description": "Asynchronous submission. The configuration must reference a registered data fixture and an HTTP model service on loopback; connectivity is exercised by the worker after admission. The caller must supply an Idempotency-Key and must not automatically retry after a lost acknowledgment.",
        "parameters": [ { "$ref": "#/components/parameters/IdempotencyKey" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "schemas/run-configuration.schema.json" },
              "examples": {
                "minimalValidSpotRun": {
                  "summary": "Controlled synthetic single-spot run",
                  "value": {
                    "contract_version": "1.0.0",
                    "simulation": {
                      "start_at": "2026-01-05T16:00:00Z",
                      "end_at": "2026-01-09T16:00:00Z",
                      "calendar_id": "synthetic-daily-utc-v1"
                    },
                    "initial_portfolio": { "cash": "100000", "positions": [] },
                    "instruments": [
                      {
                        "instrument_id": "SPOT_A",
                        "instrument_type": "spot",
                        "quote_currency": "USD",
                        "price_tick": "0.01",
                        "quantity_step": "0.001",
                        "contract_multiplier": "1",
                        "fee_bps": "0",
                        "fee_per_unit": "0",
                        "slippage_bps": "0"
                      }
                    ],
                    "data": { "fixture_id": "mvp-synthetic", "fixture_version": "v1" },
                    "model": {
                      "adapter": "http_fixture",
                      "model_id": "synthetic-model",
                      "model_version": "v1",
                      "endpoint": "http://127.0.0.1:8787/infer",
                      "timeout_ms": 5000
                    },
                    "decision_policy": {
                      "output_mode": "scores",
                      "score_policy": { "top_k": 1, "derivative_score_targets": [] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "One run was accepted, or the original acknowledgment was replayed for an equivalent submission.",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionAccepted" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/SubmissionConflict" },
          "422": { "$ref": "#/components/responses/InvalidRequest" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/submissions/{submission_id}": {
      "get": {
        "operationId": "getSubmission",
        "summary": "Resolve a submission ID to its current run",
        "parameters": [ { "$ref": "#/components/parameters/SubmissionId" } ],
        "responses": {
          "200": {
            "description": "Submission identity and current run status.",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionStatus" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Inspect run lifecycle and progress",
        "parameters": [ { "$ref": "#/components/parameters/RunId" } ],
        "responses": {
          "200": {
            "description": "Run lifecycle, current progress, and terminal failure when applicable.",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStatus" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/runs/{run_id}/evidence": {
      "get": {
        "operationId": "getRunEvidence",
        "summary": "List verified artifacts for a sealed local run",
        "parameters": [ { "$ref": "#/components/parameters/RunId" } ],
        "responses": {
          "200": { "description": "Verified evidence index for a succeeded or failed run.", "content": { "application/json": { "schema": { "$ref": "schemas/evidence-index.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/v1/runs/{run_id}/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getRunArtifact",
        "summary": "Read one verified local evidence artifact by ID",
        "description": "The backend resolves the artifact ID from the sealed manifest, verifies its path, byte size and SHA-256, and returns those exact bytes. Clients do not supply paths.",
        "parameters": [ { "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/ArtifactId" } ],
        "responses": {
          "200": { "description": "Verified stored artifact bytes.", "content": { "application/json": { "schema": {} } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/v1/replays": {
      "post": {
        "operationId": "submitReplay",
        "summary": "Enqueue verification from sealed recorded evidence",
        "parameters": [ { "$ref": "#/components/parameters/IdempotencyKey" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "schemas/replay-request.schema.json" } } } },
        "responses": {
          "202": { "description": "Accepted or previously acknowledged replay.", "content": { "application/json": { "schema": { "$ref": "schemas/replay-acknowledgement.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/SubmissionConflict" },
          "422": { "$ref": "#/components/responses/InvalidRequest" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/replays/{replay_id}": {
      "get": {
        "operationId": "getReplay",
        "summary": "Inspect replay verification lifecycle",
        "parameters": [ { "$ref": "#/components/parameters/ReplayId" } ],
        "responses": {
          "200": { "description": "Replay status.", "content": { "application/json": { "schema": { "$ref": "schemas/replay-status.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/replays/{replay_id}/report": {
      "get": {
        "operationId": "getReplayReport",
        "summary": "Read terminal recorded replay verification report",
        "parameters": [ { "$ref": "#/components/parameters/ReplayId" } ],
        "responses": {
          "200": { "description": "Replay comparison and evidence references.", "content": { "application/json": { "schema": { "$ref": "schemas/replay-report.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" }
        }
      }
    },
    "/v1/research/jobs": {
      "post": {
        "operationId": "submitResearchJob",
        "summary": "Enqueue a bounded reranking, episode, or recorded replay job",
        "parameters": [ { "$ref": "#/components/parameters/IdempotencyKey" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "schemas/research-job-request.schema.json" } } } },
        "responses": {
          "202": { "description": "Research job accepted or previously acknowledged.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResearchJobAcknowledgement" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/SubmissionConflict" },
          "422": { "$ref": "#/components/responses/InvalidRequest" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    },
    "/v1/research/jobs/{job_id}": {
      "get": {
        "operationId": "getResearchJob",
        "summary": "Inspect research job lifecycle",
        "parameters": [ { "$ref": "#/components/parameters/ResearchJobId" } ],
        "responses": {
          "200": { "description": "Current research job status.", "content": { "application/json": { "schema": { "$ref": "schemas/research-job-status.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/research/jobs/{job_id}/result": {
      "get": {
        "operationId": "getResearchResult",
        "summary": "Retrieve a completed research report",
        "parameters": [ { "$ref": "#/components/parameters/ResearchJobId" } ],
        "responses": {
          "200": { "description": "Completed result report.", "content": { "application/json": { "schema": { "$ref": "schemas/research-job-result.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" }
        }
      }
    },
    "/v1/runs/{run_id}/results": {
      "get": {
        "operationId": "getRunResults",
        "summary": "Retrieve a successful run result and evidence references",
        "parameters": [ { "$ref": "#/components/parameters/RunId" } ],
        "responses": {
          "200": {
            "description": "Successful run summary, final portfolio, provenance, and local evidence references. The backend revalidates artifact path, size, digest, and manifest before each response.",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "schemas/run-result.schema.json" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/ResultsUnavailable" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/BackendUnavailable" }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RequestId": {
        "description": "Correlation ID for this HTTP exchange; it matches error.request_id in the JSON body.",
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Caller-supplied submission UUID. Reusing it with a different configuration returns a conflict.",
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "SubmissionId": {
        "name": "submission_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "ReplayId": {
        "name": "replay_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "ResearchJobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      },
      "ArtifactId": {
        "name": "artifact_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/Uuid" }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "contract_version"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "factorsbt-backend" },
          "contract_version": { "const": "1.0.0" }
        }
      },
      "SubmissionAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submission_id", "run_id", "status", "submitted_at"],
        "properties": {
          "submission_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "const": "queued" },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" }
        }
      },
      "ResearchJobAcknowledgement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_version", "job_id", "kind", "status", "submitted_at"],
        "properties": {
          "contract_version": { "const": "1.0.0" },
          "job_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "kind": { "enum": ["reranking", "episode", "replay"] },
          "status": { "const": "queued" },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" }
        }
      },
      "SubmissionStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submission_id", "run_id", "status", "submitted_at"],
        "properties": {
          "submission_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "enum": ["queued", "running", "succeeded", "failed"] },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" }
        }
      },
      "RunStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "submitted_at", "started_at", "finished_at", "progress", "failure"],
        "properties": {
          "run_id": { "$ref": "schemas/common.schema.json#/$defs/Uuid" },
          "status": { "enum": ["queued", "running", "succeeded", "failed"] },
          "submitted_at": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" },
          "started_at": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "finished_at": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
          "progress": { "oneOf": [ { "$ref": "#/components/schemas/Progress" }, { "type": "null" } ] },
          "failure": { "oneOf": [ { "$ref": "#/components/schemas/RunFailure" }, { "type": "null" } ] }
        }
      },
      "Progress": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "step_id", "simulation_time", "completed_steps", "total_steps"],
        "properties": {
          "scenario_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "step_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "simulation_time": { "$ref": "schemas/common.schema.json#/$defs/UtcTimestamp" },
          "completed_steps": { "type": "integer", "minimum": 0 },
          "total_steps": { "type": "integer", "minimum": 0 }
        }
      },
      "RunFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "message": { "type": "string", "minLength": 1 },
          "scenario_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "step_id": { "$ref": "schemas/common.schema.json#/$defs/Identifier" },
          "last_valid_state_ref": { "type": "string", "pattern": "^evidence/[^/]+(?:/[^/]+)*$" }
        }
      },
      "RunConfiguration": { "$ref": "schemas/run-configuration.schema.json" },
      "RunResult": { "$ref": "schemas/run-result.schema.json" },
      "ErrorResponse": { "$ref": "schemas/common.schema.json#/$defs/ApiErrorResponse" }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON, malformed resource ID, or missing/invalid idempotency key.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "SubmissionConflict": {
        "description": "The submission ID is already bound to a different configuration.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InvalidRequest": {
        "description": "The run configuration is schema-invalid, semantically invalid, or uses an unsupported contract version.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "The submission or run is not retained by this backend process.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "ResultsUnavailable": {
        "description": "The run has not succeeded or has failed; inspect the run-status resource.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalError": {
        "description": "Unexpected request-processing failure; no success is implied.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "BackendUnavailable": {
        "description": "The local backend cannot accept or inspect work.",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
