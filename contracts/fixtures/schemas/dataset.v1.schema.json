{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.factorsbt.invalid/fixtures/v1/dataset.schema.json",
  "title": "FactorsBT local fixture dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "fixture_id", "fixture_version", "calendar_id", "observations", "initial_marks", "execution_prices", "settlement_events"],
  "properties": {
      "format_version": { "const": "1.1.0" },
    "fixture_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
    "fixture_version": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
    "calendar_id": { "const": "synthetic-daily-utc-v1" },
    "observations": {
      "type": "array",
      "items": { "$ref": "https://schemas.factorsbt.invalid/v1/observation.schema.json" }
    },
    "initial_marks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/InitialMark" }
    },
    "execution_prices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ExecutionPrice" }
    },
    "settlement_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/SettlementEvent" }
    }
  },
  "$defs": {
    "InitialMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "mark", "available_at", "observation_id", "source_revision"],
      "properties": {
        "instrument_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/InstrumentId" },
        "mark": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/NonNegativeDecimal" },
        "available_at": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/UtcTimestamp" },
        "observation_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
        "source_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "ExecutionPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "session_open", "price", "available_at", "observation_id", "source_revision"],
      "properties": {
        "instrument_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/InstrumentId" },
        "session_open": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/UtcTimestamp" },
        "price": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/NonNegativeDecimal" },
        "available_at": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/UtcTimestamp" },
        "observation_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
        "source_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "SettlementEvent": {
      "type": "object",
      "additionalProperties": false,
        "required": ["fixture_event_id", "instrument_id", "event_type", "event_time", "available_at", "contracts", "underlying_price", "observation_id", "source_revision"],
      "properties": {
        "fixture_event_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
        "instrument_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/InstrumentId" },
        "event_type": { "enum": ["american_exercise", "american_assignment"] },
        "event_time": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/UtcTimestamp" },
        "available_at": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/UtcTimestamp" },
          "contracts": { "type": "integer", "minimum": 1 },
        "underlying_price": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/NonNegativeDecimal" },
        "observation_id": { "$ref": "https://schemas.factorsbt.invalid/v1/common.schema.json#/$defs/Identifier" },
        "source_revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
