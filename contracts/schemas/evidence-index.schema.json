{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.factorsbt.invalid/v1/evidence-index.schema.json",
  "title": "FactorsBT sealed run evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "status", "artifacts"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "run_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "status": { "enum": ["succeeded", "failed"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "run-result.schema.json#/$defs/EvidenceArtifactRef" }
    }
  }
}
