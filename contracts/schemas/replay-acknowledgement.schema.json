{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.factorsbt.invalid/v1/replay-acknowledgement.schema.json",
  "title": "FactorsBT replay acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "replay_id", "source_run_id", "status", "submitted_at"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "replay_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "source_run_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "status": { "const": "queued" },
    "submitted_at": { "$ref": "common.schema.json#/$defs/UtcTimestamp" }
  }
}
