{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.factorsbt.invalid/v1/model-request.schema.json",
  "title": "FactorsBT correlated model inference request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "inference_id", "run_id", "scenario_id", "step_id", "snapshot_id", "model_id", "model_version", "requested_at", "simulation_time", "decision_policy", "eligible_instrument_ids", "instruments", "snapshot"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "inference_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "run_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "scenario_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "step_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "snapshot_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "model_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "model_version": { "$ref": "common.schema.json#/$defs/Identifier" },
    "requested_at": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "simulation_time": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "decision_policy": { "$ref": "run-configuration.schema.json#/properties/decision_policy" },
    "eligible_instrument_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/InstrumentId" }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "instrument.schema.json" }
    },
    "snapshot": { "$ref": "snapshot.schema.json" }
  }
}
